---
import Layout from '../layouts/Layout.astro';
import { authorData } from '../data/authorData';

const featuredBooks = authorData.books;
const primaryPoem = authorData.selectedPoems.find((p) => p.id === 'dickinson-288') || authorData.selectedPoems[0];
const { translatedAuthors } = authorData;
---

<Layout title={`${authorData.name} | ${authorData.title}`}>
  
  <!-- Single Unified Hero & About Section -->
  <section
    id="panel-hero"
    class="admin-panel relative bg-gradient-to-b from-paper-100 via-paper-50 to-[#faf8f5] pt-14 pb-16 md:pt-20 md:pb-24 border-b border-paper-200"
    data-panel-title="אודות וביוגרפיה"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Bio Content -->
      <div class="space-y-6 text-right">
        <div>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-black text-ink-950 tracking-tight leading-tight" data-editable="index-hero-title">
            {authorData.name}, <span class="font-normal text-burgundy-800 text-3xl sm:text-4xl font-serif">מתרגם</span>
          </h1>
        </div>

        <div class="space-y-4 text-base sm:text-lg text-ink-800 leading-relaxed pt-2" data-editable="index-bio-paragraphs">
          <p class="font-medium text-ink-900">
            יליד 1937, קייב, אוקראינה.
          </p>
          <p>
            עלה ארצה בשנת 1974, עבד במכון לחקר הנגב בבאר שבע ובמפעלי ים המלח בסדום עד לשנת 1999. לאחר מכן למד במשך סמסטרים רבים שירה עברית באוניברסיטה בן גוריון כשומע חופשי אצל המרצים עמוס עוז, אורי ברנשטיין, ענת ויסמן ועוד.
          </p>
          <p>
            מתחילת שנות האלפיים עסק בתרגום לרוסית את השירה העברית של שנות השישים. התרגומים ההם פורסמו בעיתונות הרוסית בארץ ובחו"ל. התקופה הזאת הסתיימה בתרגום מפורש של הספר "שיר השירים" התנכ'י, שיצא לאור בהוצאת "Филобиблон" בירושלים בשנת 2003.
          </p>
          <p>
            באמצע שנות האלפיים החלו להתפרסם תרגומיו לעברית של יצירותיהם של וסיל סטוס מאוקראינית, של אוסיפ מנדלשטם, בוריס פסטרנק מרוסית, ג'ורג' גורדון ביירון ואמילי דיקינסון מאנגלית.
          </p>
          
          <div class="pt-2">
            <p class="font-semibold text-ink-900 mb-2">יצאו לאור גם שלושה ספרים בתרגומו:</p>
            <ul class="space-y-2 text-sm sm:text-base text-ink-800 pr-5 list-disc font-serif" data-editable="index-bio-books-list">
              <li>ילנה שוורץ <strong>"אפרודיטה עוזבת בליל שבת"</strong>, הוצאת "קשב לשירה", 2010</li>
              <li>אוסיפ מנדלשטם <strong>"שירי 1934. השיחה על דנטה"</strong>, הוצאת "חבר לעט", 2015</li>
              <li>יוסיף ברודסקי <strong>"הסטנצות החדשות לאוגוסטה"</strong>, הוצאת "הקיבוץ המאוחד", 2017</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Books Shelf Section (Whole Card Clickable to /books) -->
  <section
    id="panel-books"
    class="admin-panel py-16 bg-[#faf8f5]"
    data-panel-title="ספרי תרגום"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-xl mx-auto mb-12 space-y-3">
        <h2 class="font-serif text-3xl font-bold text-ink-950" data-editable="index-books-title">
          ספרי תרגום
        </h2>
        <div class="w-12 h-0.5 bg-burgundy-700 mx-auto"></div>
        <div>
          <a 
            href="/books" 
            class="inline-flex items-center text-sm font-semibold text-burgundy-700 hover:text-burgundy-900 hover:underline pt-1"
          >
            לכל ספרי התרגום
          </a>
        </div>
      </div>

      <div id="featured-books-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredBooks.map((book) => (
          <a 
            href="/books" 
            data-book-card-id={book.id}
            class="bg-white rounded-xl border border-paper-300 p-5 flex flex-col justify-between hover:shadow-lg hover:border-burgundy-700/50 transition-all group block cursor-pointer relative"
            title={`מעבר לספר: ${book.title}`}
          >
            <div>
              <!-- Book Cover Simulation / Replaceable Image -->
              <div
                class="w-full aspect-[2/3] bg-gradient-to-br from-[#2b1b17] via-[#3d2720] to-[#1f1310] rounded-lg text-paper-100 flex flex-col justify-between shadow-inner relative overflow-hidden mb-4 group-hover:scale-[1.02] transition-transform duration-200"
                data-replaceable-image={`book-${book.id}`}
              >
                {book.coverImage ? (
                  <img src={book.coverImage} alt={book.title} class="w-full h-full object-cover" />
                ) : (
                  <div class="p-4 flex flex-col justify-between h-full">
                    <div class="absolute inset-0 border border-gold-500/20 rounded-lg pointer-events-none m-1"></div>
                    <div class="relative z-10">
                      <span class="text-[9px] tracking-widest uppercase text-paper-300 block mb-1">
                        תרגום: {authorData.name}
                      </span>
                      <h3 class="font-serif text-lg font-bold leading-tight text-white group-hover:text-gold-500 transition-colors">
                        {book.title}
                      </h3>
                      <p class="text-xs text-gold-500 font-serif mt-1">
                        {book.originalAuthor}
                      </p>
                    </div>
                    <div class="relative z-10 border-t border-white/15 pt-2 text-[10px] text-paper-300 flex justify-between items-end">
                      <span>{book.publisher}</span>
                      <span class="font-mono">{book.year}</span>
                    </div>
                  </div>
                )}
              </div>

              <h4 class="font-serif font-bold text-base text-ink-900 group-hover:text-burgundy-700 transition-colors">
                {book.title}
              </h4>
              <p class="text-xs text-burgundy-800 font-medium mb-2">
                {book.originalAuthor} ({book.originalLanguage})
              </p>
              <p class="text-xs text-ink-600 line-clamp-3 leading-relaxed">
                {book.description}
              </p>
            </div>

            <!-- Card Bottom without "פרטים" -->
            <div class="pt-3 mt-3 border-t border-paper-200 text-xs text-ink-500 flex items-center justify-between">
              <span>{book.publisher}</span>
              <span class="font-mono text-ink-400">{book.year}</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Primary Poetry Showcase Section -->
  <section
    id="panel-poems"
    class="admin-panel py-16 bg-[#faf8f5] border-t border-paper-200"
    data-panel-title="טעימת שירה"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-xl mx-auto mb-10 space-y-3">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-ink-950" data-editable="index-poems-title">
          טעימת שירה
        </h2>
        <div class="w-12 h-0.5 bg-burgundy-700 mx-auto"></div>
      </div>

      <!-- Single Primary Translation Card - Clean Literary Layout -->
      <article
        class="bg-white rounded-2xl border border-paper-300 p-8 sm:p-12 shadow-sm relative overflow-hidden"
        data-poem-card-id={primaryPoem.id}
      >
        <!-- Header -->
        <div class="border-b border-paper-200 pb-5 mb-8 text-right">
          <h3 class="font-serif text-3xl sm:text-4xl font-bold text-ink-950 leading-tight" data-editable={`poem-title-${primaryPoem.id}`}>
            {primaryPoem.title}
          </h3>
          <p class="text-base sm:text-lg font-serif text-ink-700 mt-2">
            מאת: <strong class="text-ink-950 font-semibold" data-editable={`poem-poet-${primaryPoem.id}`}>{primaryPoem.poet}</strong> • <span class="text-burgundy-800 font-medium">מאנגלית: יעקב לח</span>
          </p>
        </div>

        <!-- Full Poem Text -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
          
          <!-- Hebrew Full Translation -->
          <div class="md:col-span-7 space-y-1 text-right">
            <div class="font-serif text-xl sm:text-2xl text-ink-950 leading-relaxed sm:leading-loose space-y-1" data-editable={`poem-body-${primaryPoem.id}`}>
              {primaryPoem.hebrewText.map((line) => (
                line === "" ? <div class="h-4"></div> : <p class="font-medium">{line}</p>
              ))}
            </div>
          </div>

          <!-- English Source -->
          {primaryPoem.sourceText && (
            <div class="md:col-span-5 space-y-1 text-left border-t md:border-t-0 md:border-r border-paper-200 pt-6 md:pt-0 md:pr-8" dir="ltr">
              <div class="font-serif text-sm sm:text-base text-ink-600 leading-relaxed italic space-y-1">
                {primaryPoem.sourceText.map((line) => (
                  line === "" ? <div class="h-3"></div> : <p>{line}</p>
                ))}
              </div>
            </div>
          )}

        </div>

      </article>

    </div>
  </section>

  <!-- Additional Translations & Poets Panel -->
  <section
    id="panel-poets"
    class="admin-panel py-16 bg-[#faf8f5] border-t border-paper-200"
    data-panel-title="משוררים נוספים"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white rounded-2xl border border-paper-300 p-8 sm:p-12 shadow-sm">
        <div class="max-w-3xl mb-8">
          <span class="text-xs font-semibold text-burgundy-700 tracking-widest uppercase" data-editable="index-poets-tag">
            תרגומים נוספים בכתבי עת ועיתונות
          </span>
          <h2 class="font-serif text-3xl font-bold text-ink-950 mt-1" data-editable="index-poets-title">
            משוררים ותרגומים נוספים
          </h2>
          <p class="text-ink-600 text-sm mt-2 leading-relaxed" data-editable="index-poets-desc">
            במהלך השנים ראו אור תרגומיו של יעקב לח במיטב כתבי העת לספרות ושירה בארץ, ובעיתונות הרוסית בישראל ובחו"ל.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {translatedAuthors.map((author) => (
            <div class="p-5 rounded-xl bg-paper-50 border border-paper-200 flex flex-col justify-between">
              <div>
                <span class="text-[11px] font-semibold text-burgundy-700 block mb-1">
                  {author.language}
                </span>
                <h3 class="font-serif font-bold text-lg text-ink-900">
                  {author.name}
                </h3>
                <p class="text-xs text-ink-600 mt-2 leading-relaxed">
                  {author.description}
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-paper-200">
                <span class="text-[11px] text-ink-500 font-medium">
                  {author.books.join(', ')}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

</Layout>
