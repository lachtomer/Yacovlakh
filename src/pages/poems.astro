---
import Layout from '../layouts/Layout.astro';
import { authorData } from '../data/authorData';

const { selectedPoems } = authorData;
---

<Layout 
  title={`טעימות שירה ותרגום | ${authorData.name}`} 
  description="טעימות קריאה מתוך תרגומיו של יעקב לח: שירי אמילי דיקינסון, ברודסקי, מנדלשטם, ילנה שוורץ, וסיל סטוס וביירון."
>
  <div class="py-12 md:py-16 bg-[#faf8f5]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
        <span class="text-xs font-semibold text-burgundy-700 tracking-widest uppercase" data-editable="poems-page-tag">טעימות קריאה</span>
        <h1 class="font-serif text-4xl sm:text-5xl font-black text-ink-950" data-editable="poems-page-title">
          שירים נבחרים בתרגומו
        </h1>
        <div class="w-20 h-1 bg-burgundy-700 mx-auto"></div>
        <p class="text-base text-ink-600 font-serif leading-relaxed" data-editable="poems-page-desc">
          מבחר שירים ותרגומים מאת גדולי המשוררים ברוסית, אוקראינית ואנגלית, בהעברה שירית קפדנית לעברית.
        </p>
      </div>

      <!-- Poems List -->
      <div id="detailed-poems-list" class="space-y-12">
        {selectedPoems.map((poem) => (
          <article class="bg-white rounded-2xl border border-paper-300 p-8 sm:p-12 shadow-sm relative overflow-hidden" id={poem.id} data-poem-card-id={poem.id}>
            
            <div class="border-b border-paper-200 pb-5 mb-8">
              <span class="text-xs font-semibold text-burgundy-700 tracking-wider uppercase block mb-1">
                תרגום מ{poem.sourceLanguage}
              </span>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink-950" data-editable={`poem-title-${poem.id}`}>
                {poem.title}
              </h2>
              <p class="text-sm font-serif text-ink-600 mt-1">
                מאת: <strong class="text-ink-900" data-editable={`poem-poet-${poem.id}`}>{poem.poet}</strong> {poem.publishedIn ? `• ${poem.publishedIn}` : ''}
              </p>
            </div>

            <!-- Poem Body (Hebrew Translation with Full Niqqud) -->
            <div class="font-serif text-lg sm:text-xl text-ink-950 leading-loose space-y-3 max-w-2xl" data-editable={`poem-body-${poem.id}`}>
              {poem.hebrewText.map((line) => (
                line === "" ? <div class="h-4"></div> : <p>{line}</p>
              ))}
            </div>

            {poem.contextNote && (
              <div class="mt-8 pt-6 border-t border-paper-200 text-xs text-ink-500 italic" data-editable={`poem-context-${poem.id}`}>
                <strong>הערת רקע:</strong> {poem.contextNote}
              </div>
            )}

          </article>
        ))}
      </div>

    </div>
  </div>
</Layout>
