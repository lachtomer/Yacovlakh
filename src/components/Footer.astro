---
import { authorData } from '../data/authorData';
---

<footer class="bg-[#212124] text-paper-100 border-t border-ink-800 mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-right">
      
      <div>
        <h3 class="font-serif text-xl font-bold text-paper-50 tracking-wide">
          {authorData.name}
        </h3>
        <span class="text-xs text-paper-400 font-sans block mt-0.5">
          מתרגם
        </span>
      </div>

    </div>
  </div>
</footer>
