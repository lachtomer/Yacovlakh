---
import { authorData } from '../data/authorData';
---

<footer class="bg-[#212124] text-paper-100 border-t border-ink-800 mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-right">
      
      <div>
        <h3 class="font-serif text-xl font-bold text-paper-50 tracking-wide">
          {authorData.name}
        </h3>
        <span class="text-xs text-paper-400 font-sans block mt-0.5">
          מתרגם
        </span>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6">
        <a
          href={`mailto:${authorData.email}`}
          class="text-xs sm:text-sm text-paper-300 hover:text-gold-400 transition font-mono flex items-center gap-2"
          dir="ltr"
        >
          <svg class="w-4 h-4 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          <span>{authorData.email}</span>
        </a>

        <button
          type="button"
          data-open-admin-login
          class="text-xs text-paper-400 hover:text-gold-500 transition cursor-pointer py-1.5 px-3 rounded border border-white/10 hover:border-gold-500/40"
          title="כניסת מנהל (Ctrl+Shift+A)"
        >
          <span>כניסת מנהל</span>
        </button>
      </div>

    </div>
  </div>
</footer>
