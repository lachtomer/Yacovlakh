---
// AdminOverlay.astro
---

<div id="admin-root" dir="rtl">

  <!-- Admin Active Top Bar (Docked Top) -->
  <div
    id="admin-top-bar"
    class="fixed top-0 left-0 right-0 z-50 bg-[#1e1715] text-paper-100 border-b border-burgundy-700/60 shadow-2xl px-4 py-2.5 hidden flex-wrap items-center justify-between gap-3 text-sm font-sans"
  >
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-burgundy-900/80 text-gold-500 border border-gold-500/30">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        מצב עריכה פעיל
      </span>
      <span class="text-xs text-paper-300 hidden sm:inline">
        לחץ על טקסט לעריכה ישירה, או בחר פעולה מהסרגל
      </span>
    </div>

    <!-- Toolbar Buttons -->
    <div class="flex items-center gap-2 flex-wrap">
      <button
        id="btn-toggle-reorder"
        type="button"
        class="px-3 py-1.5 rounded-md bg-paper-100/10 hover:bg-paper-100/20 text-paper-100 text-xs font-medium border border-paper-100/20 transition flex items-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
        </svg>
        <span>סידור פאנלים</span>
      </button>

      <button
        id="btn-open-add-book"
        type="button"
        class="px-3 py-1.5 rounded-md bg-burgundy-700 hover:bg-burgundy-600 text-white text-xs font-medium transition shadow-sm flex items-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span>הוסף ספר</span>
      </button>

      <button
        id="btn-open-add-poem"
        type="button"
        class="px-3 py-1.5 rounded-md bg-burgundy-700 hover:bg-burgundy-600 text-white text-xs font-medium transition shadow-sm flex items-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span>הוסף שיר</span>
      </button>

      <button
        id="btn-open-export"
        type="button"
        class="px-3 py-1.5 rounded-md bg-paper-100/10 hover:bg-paper-100/20 text-paper-100 text-xs font-medium border border-paper-100/20 transition flex items-center gap-1.5"
        title="ייצוא כל הנתונים והשינויים לקובץ JSON"
      >
        <svg class="w-3.5 h-3.5 text-paper-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>ייצוא נתונים</span>
      </button>

      <button
        id="btn-reset-data"
        type="button"
        class="px-2.5 py-1.5 rounded-md hover:bg-red-900/40 text-red-300 hover:text-red-100 text-xs font-medium transition"
        title="איפוס כל השינויים לערכי ברירת מחדל"
      >
        איפוס
      </button>

      <button
        id="btn-admin-logout"
        type="button"
        class="px-2.5 py-1.5 rounded-md hover:bg-paper-100/10 text-paper-400 hover:text-white text-xs font-medium transition flex items-center gap-1"
        title="יציאה ממצב עריכה"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span>יציאה</span>
      </button>
    </div>
  </div>

  <!-- Toast Notification -->
  <div
    id="admin-toast"
    class="fixed bottom-6 right-6 z-50 bg-ink-900 text-paper-50 px-4 py-3 rounded-xl shadow-2xl border border-gold-500/40 text-sm font-sans flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none"
  >
    <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
    </svg>
    <span id="admin-toast-text">נשמר בהצלחה</span>
  </div>

  <!-- Modal 1: Login Modal -->
  <div
    id="modal-admin-login"
    class="fixed inset-0 z-50 bg-ink-950/70 backdrop-blur-sm hidden items-center justify-center p-4"
  >
    <div class="bg-white rounded-2xl border border-paper-300 shadow-2xl max-w-sm w-full p-6 text-right relative overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      <div class="w-12 h-12 rounded-xl bg-burgundy-50 border border-burgundy-100 text-burgundy-700 flex items-center justify-center mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
      </div>

      <h3 class="font-serif text-2xl font-bold text-ink-950 mb-1">
        כניסת מנהל לאתר
      </h3>
      <p class="text-xs text-ink-600 mb-5 leading-relaxed">
        הזן את סיסמת המנהל כדי להפעיל את מצב העריכה, להזיז פאנלים ולערוך תכנים.
      </p>

      <form id="form-admin-login" class="space-y-4">
        <div>
          <label for="admin-password-input" class="block text-xs font-semibold text-ink-800 mb-1.5">
            סיסמת מנהל
          </label>
          <div class="relative">
            <input
              type="password"
              id="admin-password-input"
              required
              autocomplete="current-password"
              placeholder="הזן סיסמה..."
              class="w-full px-3.5 py-2.5 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:outline-none focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700 transition"
            />
          </div>
          <p id="admin-login-error" class="text-xs text-red-600 mt-1.5 hidden font-medium">
            סיסמה שגויה. נסה שנית.
          </p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            id="btn-close-login"
            class="px-4 py-2 rounded-lg text-xs font-semibold text-ink-700 hover:bg-paper-100 transition"
          >
            ביטול
          </button>
          <button
            type="submit"
            class="px-5 py-2 rounded-lg text-xs font-semibold bg-burgundy-700 hover:bg-burgundy-800 text-white transition shadow-sm"
          >
            התחבר
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal 2: Add / Edit Book Modal -->
  <div
    id="modal-add-book"
    class="fixed inset-0 z-50 bg-ink-950/70 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto"
  >
    <div class="bg-white rounded-2xl border border-paper-300 shadow-2xl max-w-lg w-full p-6 sm:p-8 text-right my-8 relative animate-in fade-in zoom-in-95 duration-200">
      <div class="flex items-center justify-between border-b border-paper-200 pb-4 mb-5">
        <h3 class="font-serif text-2xl font-bold text-ink-950" id="book-modal-title">
          הוספת ספר תרגום חדש
        </h3>
        <button type="button" class="text-ink-400 hover:text-ink-800 btn-modal-close" data-target="modal-add-book">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="form-add-book" class="space-y-4 text-xs font-sans">
        <input type="hidden" id="book-id" value="" />

        <div>
          <label class="block font-semibold text-ink-800 mb-1">כותרת הספר *</label>
          <input
            type="text"
            id="book-title"
            required
            placeholder="לדוגמה: הסטנצות החדשות לאוגוסטה"
            class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block font-semibold text-ink-800 mb-1">משורר / מחבר מקורי *</label>
            <input
              type="text"
              id="book-author"
              required
              placeholder="לדוגמה: יוסיף ברודסקי"
              class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
            />
          </div>
          <div>
            <label class="block font-semibold text-ink-800 mb-1">שפת מקור *</label>
            <input
              type="text"
              id="book-language"
              required
              placeholder="לדוגמה: רוסית"
              class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block font-semibold text-ink-800 mb-1">הוצאת ספרים *</label>
            <input
              type="text"
              id="book-publisher"
              required
              placeholder="לדוגמה: הוצאת הקיבוץ המאוחד"
              class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
            />
          </div>
          <div>
            <label class="block font-semibold text-ink-800 mb-1">שנת הוצאה *</label>
            <input
              type="number"
              id="book-year"
              required
              placeholder="2017"
              class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
            />
          </div>
        </div>

        <div>
          <label class="block font-semibold text-ink-800 mb-1">ציטוט קצר מהספר (אופציונלי)</label>
          <input
            type="text"
            id="book-quote"
            placeholder="ציטוט בולט..."
            class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
          />
        </div>

        <div>
          <label class="block font-semibold text-ink-800 mb-1">תיאור הספר *</label>
          <textarea
            id="book-description"
            rows="3"
            required
            placeholder="תיאור קצר של היצירה, הרקע והתרגום..."
            class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
          ></textarea>
        </div>

        <div>
          <label class="block font-semibold text-ink-800 mb-1">תמונת כריכה (קישור URL או קובץ תמונה)</label>
          <div class="flex items-center gap-2">
            <input
              type="text"
              id="book-cover-url"
              placeholder="https://... או השאר ריק לכריכה טיפוגרפית"
              class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
            />
            <label class="px-3 py-2 bg-paper-200 hover:bg-paper-300 rounded-lg cursor-pointer text-ink-800 whitespace-nowrap transition">
              העלאה
              <input type="file" id="book-cover-file" accept="image/*" class="hidden" />
            </label>
          </div>
          <div id="book-cover-preview" class="mt-2 hidden">
            <img src="" alt="תצוגה מקדימה" class="h-20 w-auto rounded border border-paper-300 shadow-sm" />
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-4 border-t border-paper-200">
          <button
            type="button"
            class="px-4 py-2 rounded-lg text-xs font-semibold text-ink-700 hover:bg-paper-100 transition btn-modal-close"
            data-target="modal-add-book"
          >
            ביטול
          </button>
          <button
            type="submit"
            class="px-5 py-2 rounded-lg text-xs font-semibold bg-burgundy-700 hover:bg-burgundy-800 text-white transition shadow-sm"
          >
            שמור ספר
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal 3: Add / Edit Song/Poem Modal -->
  <div
    id="modal-add-poem"
    class="fixed inset-0 z-50 bg-ink-950/70 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto"
  >
    <div class="bg-white rounded-2xl border border-paper-300 shadow-2xl max-w-lg w-full p-6 sm:p-8 text-right my-8 relative animate-in fade-in zoom-in-95 duration-200">
      <div class="flex items-center justify-between border-b border-paper-200 pb-4 mb-5">
        <h3 class="font-serif text-2xl font-bold text-ink-950" id="poem-modal-title">
          הוספת שיר / תרגום חדש
        </h3>
        <button type="button" class="text-ink-400 hover:text-ink-800 btn-modal-close" data-target="modal-add-poem">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="form-add-poem" class="space-y-4 text-xs font-sans">
        <input type="hidden" id="poem-id" value="" />

        <div>
          <label class="block font-semibold text-ink-800 mb-1">כותרת השיר *</label>
          <input
            type="text"
            id="poem-title"
            required
            placeholder="לדוגמה: אֲנִי אֵינִי! (שיר 288)"
            class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block font-semibold text-ink-800 mb-1">משורר/ת *</label>
            <input
              type="text"
              id="poem-poet"
              required
              placeholder="לדוגמה: אמילי דיקינסון"
              class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
            />
          </div>
          <div>
            <label class="block font-semibold text-ink-800 mb-1">שפת מקור *</label>
            <input
              type="text"
              id="poem-language"
              required
              placeholder="לדוגמה: אנגלית / רוסית"
              class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block font-semibold text-ink-800 mb-1">היכן פורסם התרגום (אופציונלי)</label>
            <input
              type="text"
              id="poem-published"
              placeholder="מאנגלית: יעקב לח / כתב עת"
              class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
            />
          </div>
          <div>
            <label class="block font-semibold text-ink-800 mb-1">שנה (אופציונלי)</label>
            <input
              type="text"
              id="poem-year"
              placeholder="2017"
              class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
            />
          </div>
        </div>

        <div>
          <label class="block font-semibold text-ink-800 mb-1">תרגום השיר לעברית (שורה אחר שורה, תומך ניקוד) *</label>
          <textarea
            id="poem-hebrew-text"
            rows="5"
            required
            placeholder="הזן את שורות השיר בעברית..."
            class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm font-serif text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
          ></textarea>
        </div>

        <div>
          <label class="block font-semibold text-ink-800 mb-1">טקסט המקור (אופציונלי - שורה אחר שורה)</label>
          <textarea
            id="poem-source-text"
            rows="3"
            dir="ltr"
            placeholder="Original text lines..."
            class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm font-serif text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700 text-left"
          ></textarea>
        </div>

        <div>
          <label class="block font-semibold text-ink-800 mb-1">הערת רקע ספרותית (אופציונלי)</label>
          <input
            type="text"
            id="poem-context"
            placeholder="רקע על השיר, המשורר או התרגום..."
            class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
          />
        </div>

        <div class="flex items-center justify-end gap-2 pt-4 border-t border-paper-200">
          <button
            type="button"
            class="px-4 py-2 rounded-lg text-xs font-semibold text-ink-700 hover:bg-paper-100 transition btn-modal-close"
            data-target="modal-add-poem"
          >
            ביטול
          </button>
          <button
            type="submit"
            class="px-5 py-2 rounded-lg text-xs font-semibold bg-burgundy-700 hover:bg-burgundy-800 text-white transition shadow-sm"
          >
            שמור שיר
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal 4: Replace Image Modal -->
  <div
    id="modal-replace-image"
    class="fixed inset-0 z-50 bg-ink-950/70 backdrop-blur-sm hidden items-center justify-center p-4"
  >
    <div class="bg-white rounded-2xl border border-paper-300 shadow-2xl max-w-sm w-full p-6 text-right relative animate-in fade-in zoom-in-95 duration-200">
      <div class="flex items-center justify-between border-b border-paper-200 pb-3 mb-4">
        <h3 class="font-serif text-xl font-bold text-ink-950">
          החלפת תמונה
        </h3>
        <button type="button" class="text-ink-400 hover:text-ink-800 btn-modal-close" data-target="modal-replace-image">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <input type="hidden" id="replace-image-target-id" value="" />

      <div class="space-y-4 text-xs font-sans">
        <!-- Live Preview -->
        <div class="w-full h-44 bg-paper-100 rounded-xl border border-paper-300 flex items-center justify-center overflow-hidden">
          <img id="replace-image-preview" src="" alt="תצוגה מקדימה" class="max-h-full max-w-full object-contain" />
          <span id="replace-image-placeholder" class="text-ink-400">בחר תמונה להצגה מקדימה</span>
        </div>

        <div>
          <label class="block font-semibold text-ink-800 mb-1">העלאת קובץ תמונה מהמחשב</label>
          <input
            type="file"
            id="replace-image-file"
            accept="image/*"
            class="block w-full text-xs text-ink-600 file:mr-0 file:ml-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-burgundy-50 file:text-burgundy-700 hover:file:bg-burgundy-100 cursor-pointer"
          />
        </div>

        <div class="relative flex items-center justify-center">
          <div class="border-t border-paper-200 w-full"></div>
          <span class="bg-white px-2 text-ink-400 text-[11px] absolute">או</span>
        </div>

        <div>
          <label class="block font-semibold text-ink-800 mb-1">הזנת קישור ישיר (URL)</label>
          <input
            type="url"
            id="replace-image-url"
            placeholder="https://example.com/photo.jpg"
            class="w-full px-3 py-2 bg-paper-50 border border-paper-300 rounded-lg text-sm text-ink-950 focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700"
          />
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-paper-200">
          <button
            type="button"
            class="px-4 py-2 rounded-lg text-xs font-semibold text-ink-700 hover:bg-paper-100 transition btn-modal-close"
            data-target="modal-replace-image"
          >
            ביטול
          </button>
          <button
            type="button"
            id="btn-confirm-replace-image"
            class="px-5 py-2 rounded-lg text-xs font-semibold bg-burgundy-700 hover:bg-burgundy-800 text-white transition shadow-sm"
          >
            עדכן תמונה
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal 5: Export Data Modal -->
  <div
    id="modal-export-data"
    class="fixed inset-0 z-50 bg-ink-950/70 backdrop-blur-sm hidden items-center justify-center p-4"
  >
    <div class="bg-white rounded-2xl border border-paper-300 shadow-2xl max-w-lg w-full p-6 text-right relative animate-in fade-in zoom-in-95 duration-200">
      <div class="flex items-center justify-between border-b border-paper-200 pb-3 mb-4">
        <h3 class="font-serif text-xl font-bold text-ink-950">
          ייצוא נתוני האתר (JSON)
        </h3>
        <button type="button" class="text-ink-400 hover:text-ink-800 btn-modal-close" data-target="modal-export-data">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <p class="text-xs text-ink-600 mb-3 font-sans leading-relaxed">
        כל השינויים שביצעת (טקסטים, ספרים שנוספו, שירים, תמונות וסדר הפאנלים) מרוכזים להלן. ניתן להעתיק או להוריד כקובץ.
      </p>

      <textarea
        id="export-json-textarea"
        rows="10"
        readonly
        dir="ltr"
        class="w-full px-3 py-2 bg-paper-100 border border-paper-300 rounded-lg text-xs font-mono text-ink-900 focus:outline-none"
      ></textarea>

      <div class="flex items-center justify-between pt-4 border-t border-paper-200 mt-3 font-sans">
        <button
          type="button"
          id="btn-copy-export"
          class="px-4 py-2 rounded-lg text-xs font-semibold bg-paper-200 hover:bg-paper-300 text-ink-900 transition flex items-center gap-1.5"
        >
          <span>העתק ללוח</span>
        </button>
        <button
          type="button"
          id="btn-download-export"
          class="px-4 py-2 rounded-lg text-xs font-semibold bg-burgundy-700 hover:bg-burgundy-800 text-white transition shadow-sm flex items-center gap-1.5"
        >
          <span>הורד כקובץ JSON</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Admin Editing UI Styles */
  body.admin-mode {
    padding-top: 50px !important;
  }

  body.admin-mode [data-editable] {
    position: relative;
    outline: 1.5px dashed rgba(124, 22, 38, 0.4);
    outline-offset: 3px;
    border-radius: 4px;
    cursor: text;
    transition: all 0.2s ease;
  }

  body.admin-mode [data-editable]:hover {
    outline: 2px solid #7c1626;
    background-color: rgba(253, 242, 244, 0.6);
  }

  body.admin-mode [data-editable]:focus {
    outline: 2px solid #7c1626;
    background-color: #ffffff;
    box-shadow: 0 0 0 4px rgba(124, 22, 38, 0.15);
  }

  /* Image replacement trigger */
  body.admin-mode .admin-image-container {
    position: relative;
  }

  body.admin-mode .admin-image-overlay-btn {
    display: flex !important;
  }

  /* Panel Reordering Controls */
  body.admin-mode.reordering-active .admin-panel-control-bar {
    display: flex !important;
  }

  body.admin-mode.reordering-active .admin-panel {
    border: 2px dashed #a8801d !important;
    position: relative;
    margin: 8px 0;
    transition: all 0.2s ease;
  }
</style>

<script is:inline>
(function () {
  // Admin Keys & Defaults
  const STORAGE_KEYS = {
    AUTH: 'yakov_admin_auth_v1',
    PASSWORD: 'yakov_admin_password_v1',
    BOOKS: 'yakov_admin_books_v1',
    POEMS: 'yakov_admin_poems_v1',
    TEXTS: 'yakov_admin_texts_v1',
    IMAGES: 'yakov_admin_images_v1',
    PANEL_ORDER: 'yakov_admin_panel_order_v1',
  };

  const DEFAULT_PASSWORD = 'YoavMaya0912';

  // State
  let isAdmin = false;
  let isReordering = false;

  // DOM Elements
  const adminRoot = document.getElementById('admin-root');
  const triggerBtn = document.getElementById('admin-trigger-btn');
  const topBar = document.getElementById('admin-top-bar');
  const toast = document.getElementById('admin-toast');
  const toastText = document.getElementById('admin-toast-text');

  // Modals
  const loginModal = document.getElementById('modal-admin-login');
  const addBookModal = document.getElementById('modal-add-book');
  const addPoemModal = document.getElementById('modal-add-poem');
  const replaceImgModal = document.getElementById('modal-replace-image');
  const exportModal = document.getElementById('modal-export-data');

  function showToast(msg) {
    if (!toast || !toastText) return;
    toastText.textContent = msg;
    toast.classList.remove('translate-y-20', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      toast.classList.add('translate-y-20', 'opacity-0');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 2500);
  }

  function openModal(modal) {
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function closeModal(modal) {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  // Check login
  function checkAuth() {
    return sessionStorage.getItem(STORAGE_KEYS.AUTH) === 'true';
  }

  function setAuth(authenticated) {
    isAdmin = authenticated;
    if (authenticated) {
      sessionStorage.setItem(STORAGE_KEYS.AUTH, 'true');
      document.body.classList.add('admin-mode');
      if (topBar) {
        topBar.classList.remove('hidden');
        topBar.classList.add('flex');
      }
      if (triggerBtn) triggerBtn.classList.add('hidden');
      enableInlineEditing();
      injectPanelControls();
      injectCardControls();
      injectImageReplaceControls();
    } else {
      sessionStorage.removeItem(STORAGE_KEYS.AUTH);
      document.body.classList.remove('admin-mode', 'reordering-active');
      if (topBar) {
        topBar.classList.add('hidden');
        topBar.classList.remove('flex');
      }
      if (triggerBtn) triggerBtn.classList.remove('hidden');
      disableInlineEditing();
    }
  }

  // --- Inline Text Editing ---
  function getSavedTexts() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEYS.TEXTS) || '{}');
    } catch {
      return {};
    }
  }

  function saveText(id, value) {
    const texts = getSavedTexts();
    texts[id] = value;
    localStorage.setItem(STORAGE_KEYS.TEXTS, JSON.stringify(texts));
    showToast('השינויים נשמרו');
  }

  function applySavedTexts() {
    const texts = getSavedTexts();
    document.querySelectorAll('[data-editable]').forEach((el) => {
      const id = el.getAttribute('data-editable');
      if (id && texts[id] !== undefined) {
        el.innerHTML = texts[id];
      }
    });
  }

  function enableInlineEditing() {
    document.querySelectorAll('[data-editable]').forEach((el) => {
      el.setAttribute('contenteditable', 'true');
      el.setAttribute('spellcheck', 'false');
      el.onblur = function () {
        const id = el.getAttribute('data-editable');
        if (id) saveText(id, el.innerHTML);
      };
    });
  }

  function disableInlineEditing() {
    document.querySelectorAll('[data-editable]').forEach((el) => {
      el.removeAttribute('contenteditable');
      el.onblur = null;
    });
  }

  // --- Image Replacement ---
  function getSavedImages() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEYS.IMAGES) || '{}');
    } catch {
      return {};
    }
  }

  function applySavedImages() {
    const images = getSavedImages();
    Object.keys(images).forEach((key) => {
      const target = document.querySelector(`[data-replaceable-image="${key}"]`);
      if (target) {
        if (target.tagName === 'IMG') {
          target.src = images[key];
        } else {
          const imgChild = target.querySelector('img');
          if (imgChild) {
            imgChild.src = images[key];
          } else {
            target.style.backgroundImage = `url("${images[key]}")`;
            target.style.backgroundSize = 'cover';
            target.style.backgroundPosition = 'center';
          }
        }
      }
    });
  }

  function injectImageReplaceControls() {
    document.querySelectorAll('[data-replaceable-image]').forEach((container) => {
      if (container.querySelector('.admin-image-overlay-btn')) return;

      container.classList.add('relative', 'group');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'admin-image-overlay-btn absolute inset-0 m-auto w-max h-max px-3 py-1.5 bg-burgundy-800/90 text-white rounded-lg text-xs font-semibold shadow-lg hidden items-center gap-1.5 transition hover:bg-burgundy-900 border border-white/20 z-30 cursor-pointer';
      btn.innerHTML = `
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>החלף תמונה</span>
      `;
      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const imgKey = container.getAttribute('data-replaceable-image');
        openReplaceImageModal(imgKey);
      };
      container.appendChild(btn);
    });
  }

  function openReplaceImageModal(key) {
    const targetInput = document.getElementById('replace-image-target-id');
    const preview = document.getElementById('replace-image-preview');
    const placeholder = document.getElementById('replace-image-placeholder');
    const urlInput = document.getElementById('replace-image-url');
    const fileInput = document.getElementById('replace-image-file');

    if (!targetInput) return;
    targetInput.value = key;
    if (urlInput) urlInput.value = '';
    if (fileInput) fileInput.value = '';

    const currentImgs = getSavedImages();
    if (currentImgs[key]) {
      preview.src = currentImgs[key];
      preview.classList.remove('hidden');
      if (placeholder) placeholder.classList.add('hidden');
    } else {
      preview.src = '';
      preview.classList.add('hidden');
      if (placeholder) placeholder.classList.remove('hidden');
    }

    openModal(replaceImgModal);
  }

  // --- Panels Reordering ---
  function getSavedPanelOrder() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEYS.PANEL_ORDER));
    } catch {
      return null;
    }
  }

  function applyPanelOrder() {
    const order = getSavedPanelOrder();
    if (!order || !Array.isArray(order) || order.length === 0) return;

    const main = document.querySelector('main');
    if (!main) return;

    order.forEach((panelId) => {
      const el = document.getElementById(panelId);
      if (el && el.parentElement === main) {
        main.appendChild(el);
      }
    });
  }

  function saveCurrentPanelOrder() {
    const panels = Array.from(document.querySelectorAll('main > .admin-panel'));
    const order = panels.map((p) => p.id).filter(Boolean);
    localStorage.setItem(STORAGE_KEYS.PANEL_ORDER, JSON.stringify(order));
    showToast('סדר הפאנלים נשמר');
  }

  function injectPanelControls() {
    const panels = document.querySelectorAll('main > .admin-panel');
    panels.forEach((panel) => {
      if (panel.querySelector('.admin-panel-control-bar')) return;

      const bar = document.createElement('div');
      bar.className = 'admin-panel-control-bar w-full bg-[#2a1d1a] text-paper-100 px-4 py-2 flex items-center justify-between gap-3 text-xs font-sans border-b border-gold-600/30 hidden z-20';
      bar.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="font-bold text-gold-500">פאנל: ${panel.getAttribute('data-panel-title') || panel.id}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <button type="button" class="btn-panel-up px-2.5 py-1 bg-paper-100/10 hover:bg-paper-100/20 rounded text-paper-200 hover:text-white transition flex items-center gap-1" title="הזז למעלה">
            <span>↑ למעלה</span>
          </button>
          <button type="button" class="btn-panel-down px-2.5 py-1 bg-paper-100/10 hover:bg-paper-100/20 rounded text-paper-200 hover:text-white transition flex items-center gap-1" title="הזז למטה">
            <span>↓ למטה</span>
          </button>
        </div>
      `;

      bar.querySelector('.btn-panel-up').onclick = (e) => {
        e.preventDefault();
        const prev = panel.previousElementSibling;
        if (prev && prev.classList.contains('admin-panel')) {
          panel.parentElement.insertBefore(panel, prev);
          saveCurrentPanelOrder();
        }
      };

      bar.querySelector('.btn-panel-down').onclick = (e) => {
        e.preventDefault();
        const next = panel.nextElementSibling;
        if (next && next.classList.contains('admin-panel')) {
          panel.parentElement.insertBefore(next, panel);
          saveCurrentPanelOrder();
        }
      };

      panel.insertBefore(bar, panel.firstChild);
    });
  }

  // --- Dynamic Books & Poems ---
  function getCustomBooks() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEYS.BOOKS) || '[]');
    } catch {
      return [];
    }
  }

  function saveCustomBooks(books) {
    localStorage.setItem(STORAGE_KEYS.BOOKS, JSON.stringify(books));
  }

  function getCustomPoems() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEYS.POEMS) || '[]');
    } catch {
      return [];
    }
  }

  function saveCustomPoems(poems) {
    localStorage.setItem(STORAGE_KEYS.POEMS, JSON.stringify(poems));
  }

  function renderCustomBooks() {
    const books = getCustomBooks();
    if (!books.length) return;

    const indexGrid = document.getElementById('featured-books-grid');
    const booksList = document.getElementById('detailed-books-list');

    books.forEach((book) => {
      if (document.querySelector(`[data-book-card-id="${book.id}"]`)) return;

      if (indexGrid) {
        const card = document.createElement('div');
        card.setAttribute('data-book-card-id', book.id);
        card.className = 'bg-white rounded-xl border border-paper-300 p-5 flex flex-col justify-between hover:shadow-lg hover:border-burgundy-700/50 transition-all group block relative';
        card.innerHTML = `
          <div>
            <div class="w-full aspect-[2/3] bg-gradient-to-br from-[#2b1b17] via-[#3d2720] to-[#1f1310] rounded-lg text-paper-100 flex flex-col justify-between shadow-inner relative overflow-hidden mb-4" data-replaceable-image="book-${book.id}">
              ${book.coverImage ? `<img src="${book.coverImage}" class="w-full h-full object-cover" />` : `
                <div class="p-4 flex flex-col justify-between h-full">
                  <div class="absolute inset-0 border border-gold-500/20 rounded-lg pointer-events-none m-1"></div>
                  <div class="relative z-10">
                    <span class="text-[9px] tracking-widest uppercase text-paper-300 block mb-1">תרגום: יעקב לח</span>
                    <h3 class="font-serif text-lg font-bold leading-tight text-white group-hover:text-gold-500 transition-colors">${book.title}</h3>
                    <p class="text-xs text-gold-500 font-serif mt-1">${book.originalAuthor}</p>
                  </div>
                  <div class="relative z-10 border-t border-white/15 pt-2 text-[10px] text-paper-300 flex justify-between items-end">
                    <span>${book.publisher}</span>
                    <span class="font-mono">${book.year}</span>
                  </div>
                </div>
              `}
            </div>
            <h4 class="font-serif font-bold text-base text-ink-900 group-hover:text-burgundy-700 transition-colors">${book.title}</h4>
            <p class="text-xs text-burgundy-800 font-medium mb-2">${book.originalAuthor} (${book.originalLanguage})</p>
            <p class="text-xs text-ink-600 line-clamp-3 leading-relaxed">${book.description}</p>
          </div>
          <div class="pt-3 mt-3 border-t border-paper-200 text-xs text-ink-500 flex items-center justify-between">
            <span>${book.publisher}</span>
            <span class="font-mono text-ink-400">${book.year}</span>
          </div>
        `;
        indexGrid.appendChild(card);
      }

      if (booksList) {
        const article = document.createElement('article');
        article.setAttribute('data-book-card-id', book.id);
        article.className = 'bg-white rounded-2xl border border-paper-300 p-6 sm:p-8 lg:p-10 shadow-sm hover:shadow-md transition-shadow relative';
        article.innerHTML = `
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <div class="lg:col-span-4 flex justify-center">
              <div class="w-full max-w-[260px] aspect-[2/3] bg-gradient-to-br from-[#241715] via-[#35211c] to-[#1a0f0d] rounded-xl text-paper-100 flex flex-col justify-between shadow-xl relative border-2 border-gold-600/30 overflow-hidden" data-replaceable-image="book-${book.id}">
                ${book.coverImage ? `<img src="${book.coverImage}" class="w-full h-full object-cover" />` : `
                  <div class="p-6 flex flex-col justify-between h-full">
                    <div class="absolute inset-2 border border-gold-500/20 rounded-lg pointer-events-none"></div>
                    <div class="relative z-10">
                      <span class="text-[11px] font-sans text-paper-300 tracking-widest block mb-2">תרגום: יעקב לח</span>
                      <h2 class="font-serif text-2xl font-bold text-white leading-tight">${book.title}</h2>
                      <p class="font-serif text-sm text-gold-500 mt-2">${book.originalAuthor}</p>
                    </div>
                    <div class="relative z-10 border-t border-white/20 pt-3 text-xs text-paper-300 flex justify-between items-end font-sans">
                      <span>${book.publisher}</span>
                      <span class="font-mono text-paper-200">${book.year}</span>
                    </div>
                  </div>
                `}
              </div>
            </div>
            <div class="lg:col-span-8 space-y-4 text-right">
              <span class="px-3 py-1 bg-burgundy-50 text-burgundy-800 text-xs font-semibold rounded-full border border-burgundy-100 inline-block">
                תרגום מ${book.originalLanguage}
              </span>
              <h2 class="font-serif text-3xl font-bold text-ink-950">${book.title}</h2>
              <p class="text-base text-ink-700 font-medium">מאת: <strong class="text-ink-950">${book.originalAuthor}</strong></p>
              ${book.quote ? `<div class="p-4 bg-paper-50 rounded-xl border-r-4 border-burgundy-700 italic font-serif text-base text-ink-800">${book.quote}</div>` : ''}
              <p class="text-sm text-ink-700 leading-relaxed">${book.description}</p>
              <div class="pt-4 border-t border-paper-200 flex items-center justify-between text-xs text-ink-500 font-sans">
                <span><strong>הוצאה:</strong> ${book.publisher}</span>
                <span><strong>שנה:</strong> ${book.year}</span>
              </div>
            </div>
          </div>
        `;
        booksList.appendChild(article);
      }
    });

    if (isAdmin) {
      injectCardControls();
      injectImageReplaceControls();
    }
  }

  function renderCustomPoems() {
    const poems = getCustomPoems();
    if (!poems.length) return;

    const indexGrid = document.getElementById('featured-poems-grid');
    const poemsList = document.getElementById('detailed-poems-list');

    poems.forEach((poem) => {
      if (document.querySelector(`[data-poem-card-id="${poem.id}"]`)) return;

      if (indexGrid) {
        const card = document.createElement('div');
        card.setAttribute('data-poem-card-id', poem.id);
        card.className = 'bg-white rounded-xl border border-paper-300 p-5 flex flex-col justify-between hover:shadow-lg hover:border-burgundy-700/50 transition-all group block relative';
        card.innerHTML = `
          <div>
            <div class="w-full aspect-[2/3] bg-gradient-to-br from-[#1a232b] via-[#24303c] to-[#131a21] rounded-lg p-4 text-paper-100 flex flex-col justify-between shadow-inner relative overflow-hidden mb-4">
              <div class="absolute inset-0 border border-gold-500/20 rounded-lg pointer-events-none m-1"></div>
              <div>
                <span class="text-[9px] tracking-widest uppercase text-paper-300 block mb-1">תרגום: יעקב לח</span>
                <h3 class="font-serif text-lg font-bold leading-tight text-white group-hover:text-gold-500 transition-colors">${poem.title}</h3>
                <p class="text-xs text-gold-500 font-serif mt-1">${poem.poet}</p>
              </div>
              <div class="border-t border-white/15 pt-2 text-[10px] text-paper-300 flex justify-between items-end">
                <span>מ${poem.sourceLanguage}</span>
                <span class="font-mono text-paper-300">שירה</span>
              </div>
            </div>
            <h4 class="font-serif font-bold text-base text-ink-900 group-hover:text-burgundy-700 transition-colors">${poem.title}</h4>
            <p class="text-xs text-burgundy-800 font-medium mb-2">${poem.poet} (${poem.sourceLanguage})</p>
            <div class="text-xs text-ink-800 font-serif leading-relaxed space-y-1 bg-paper-50/70 p-3 rounded-lg border border-paper-200">
              ${(poem.hebrewText || []).slice(0, 4).map((line) => `<p>${line}</p>`).join('')}
            </div>
          </div>
          <div class="pt-3 mt-3 border-t border-paper-200 text-xs text-ink-500">
            <span>${poem.publishedIn ? poem.publishedIn.slice(0, 15) : `תרגום מ${poem.sourceLanguage}`}</span>
          </div>
        `;
        indexGrid.appendChild(card);
      }

      if (poemsList) {
        const article = document.createElement('article');
        article.setAttribute('data-poem-card-id', poem.id);
        article.className = 'bg-white rounded-2xl border border-paper-300 p-8 sm:p-12 shadow-sm relative overflow-hidden';
        article.innerHTML = `
          <div class="border-b border-paper-200 pb-5 mb-8">
            <span class="text-xs font-semibold text-burgundy-700 tracking-wider uppercase block mb-1">תרגום מ${poem.sourceLanguage}</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink-950">${poem.title}</h2>
            <p class="text-sm font-serif text-ink-600 mt-1">מאת: <strong class="text-ink-900">${poem.poet}</strong> ${poem.publishedIn ? `• ${poem.publishedIn}` : ''}</p>
          </div>
          <div class="font-serif text-lg sm:text-xl text-ink-950 leading-loose space-y-3 max-w-2xl">
            ${(poem.hebrewText || []).map((l) => (l === '' ? '<div class="h-4"></div>' : `<p>${l}</p>`)).join('')}
          </div>
          ${poem.contextNote ? `<div class="mt-8 pt-6 border-t border-paper-200 text-xs text-ink-500 italic"><strong>הערת רקע:</strong> ${poem.contextNote}</div>` : ''}
        `;
        poemsList.appendChild(article);
      }
    });

    if (isAdmin) {
      injectCardControls();
    }
  }

  function injectCardControls() {
    // Delete buttons on custom books & poems
    document.querySelectorAll('[data-book-card-id]').forEach((card) => {
      const bookId = card.getAttribute('data-book-card-id');
      const customBooks = getCustomBooks();
      const isCustom = customBooks.some((b) => b.id === bookId);
      if (isCustom && !card.querySelector('.btn-delete-custom-item')) {
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-delete-custom-item absolute top-3 left-3 bg-red-700 hover:bg-red-800 text-white rounded-full p-1.5 shadow transition z-20';
        delBtn.title = 'מחק ספר זה';
        delBtn.innerHTML = `
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        `;
        delBtn.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (confirm('האם אתה בטוח שברצונך למחוק ספר זה?')) {
            const updated = customBooks.filter((b) => b.id !== bookId);
            saveCustomBooks(updated);
            document.querySelectorAll(`[data-book-card-id="${bookId}"]`).forEach((el) => el.remove());
            showToast('הספר נמחק');
          }
        };
        card.appendChild(delBtn);
      }
    });

    document.querySelectorAll('[data-poem-card-id]').forEach((card) => {
      const poemId = card.getAttribute('data-poem-card-id');
      const customPoems = getCustomPoems();
      const isCustom = customPoems.some((p) => p.id === poemId);
      if (isCustom && !card.querySelector('.btn-delete-custom-item')) {
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-delete-custom-item absolute top-3 left-3 bg-red-700 hover:bg-red-800 text-white rounded-full p-1.5 shadow transition z-20';
        delBtn.title = 'מחק שיר זה';
        delBtn.innerHTML = `
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        `;
        delBtn.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (confirm('האם אתה בטוח שברצונך למחוק שיר זה?')) {
            const updated = customPoems.filter((p) => p.id !== poemId);
            saveCustomPoems(updated);
            document.querySelectorAll(`[data-poem-card-id="${poemId}"]`).forEach((el) => el.remove());
            showToast('השיר נמחק');
          }
        };
        card.appendChild(delBtn);
      }
    });
  }

  // --- Initialize Event Handlers ---
  function setupEventListeners() {
    // Open Login Modal
    if (triggerBtn) {
      triggerBtn.onclick = () => openModal(loginModal);
    }

    // Connect any element with data-open-admin-login
    document.querySelectorAll('[data-open-admin-login]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        if (isAdmin) {
          showToast('אתה כבר מחובר כמנהל');
        } else {
          openModal(loginModal);
        }
      });
    });

    // Keyboard shortcut Ctrl + Shift + A
    window.addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.shiftKey && (e.key === 'A' || e.key === 'a')) {
        e.preventDefault();
        if (isAdmin) {
          setAuth(false);
          showToast('יצאת ממצב עריכה');
        } else {
          openModal(loginModal);
        }
      }
    });

    // Close buttons on all modals
    document.querySelectorAll('.btn-modal-close').forEach((btn) => {
      btn.onclick = () => {
        const targetId = btn.getAttribute('data-target');
        if (targetId) closeModal(document.getElementById(targetId));
      };
    });

    const btnCloseLogin = document.getElementById('btn-close-login');
    if (btnCloseLogin) btnCloseLogin.onclick = () => closeModal(loginModal);

    // Login Form Submit
    const loginForm = document.getElementById('form-admin-login');
    const pwdInput = document.getElementById('admin-password-input');
    const loginError = document.getElementById('admin-login-error');

    if (loginForm) {
      loginForm.onsubmit = (e) => {
        e.preventDefault();
        const entered = (pwdInput.value || '').trim();
        const storedPwd = localStorage.getItem(STORAGE_KEYS.PASSWORD) || DEFAULT_PASSWORD;

        if (entered === storedPwd) {
          if (loginError) loginError.classList.add('hidden');
          pwdInput.value = '';
          closeModal(loginModal);
          setAuth(true);
          showToast('התחברת בהצלחה כמנהל!');
        } else {
          if (loginError) loginError.classList.remove('hidden');
        }
      };
    }

    // Logout
    const btnLogout = document.getElementById('btn-admin-logout');
    if (btnLogout) {
      btnLogout.onclick = () => {
        setAuth(false);
        showToast('יצאת ממצב עריכה');
      };
    }

    // Toggle Reordering
    const btnReorder = document.getElementById('btn-toggle-reorder');
    if (btnReorder) {
      btnReorder.onclick = () => {
        isReordering = !isReordering;
        if (isReordering) {
          document.body.classList.add('reordering-active');
          btnReorder.classList.add('bg-gold-500/30', 'border-gold-500');
          showToast('מצב סידור פאנלים פעיל - השתמש בחצים להזזה');
        } else {
          document.body.classList.remove('reordering-active');
          btnReorder.classList.remove('bg-gold-500/30', 'border-gold-500');
          showToast('יצאת ממצב סידור פאנלים');
        }
      };
    }

    // Open Add Book Modal
    const btnAddBook = document.getElementById('btn-open-add-book');
    if (btnAddBook) {
      btnAddBook.onclick = () => {
        document.getElementById('form-add-book').reset();
        document.getElementById('book-id').value = 'book-' + Date.now();
        const preview = document.getElementById('book-cover-preview');
        if (preview) preview.classList.add('hidden');
        openModal(addBookModal);
      };
    }

    // File input for book cover
    const bookCoverFile = document.getElementById('book-cover-file');
    const bookCoverUrl = document.getElementById('book-cover-url');
    const bookCoverPreview = document.getElementById('book-cover-preview');

    if (bookCoverFile) {
      bookCoverFile.onchange = () => {
        const file = bookCoverFile.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (evt) => {
            bookCoverUrl.value = evt.target.result;
            if (bookCoverPreview) {
              bookCoverPreview.querySelector('img').src = evt.target.result;
              bookCoverPreview.classList.remove('hidden');
            }
          };
          reader.readAsDataURL(file);
        }
      };
    }

    // Save Book Form
    const bookForm = document.getElementById('form-add-book');
    if (bookForm) {
      bookForm.onsubmit = (e) => {
        e.preventDefault();
        const newBook = {
          id: document.getElementById('book-id').value || 'book-' + Date.now(),
          title: document.getElementById('book-title').value.trim(),
          originalAuthor: document.getElementById('book-author').value.trim(),
          originalLanguage: document.getElementById('book-language').value.trim(),
          publisher: document.getElementById('book-publisher').value.trim(),
          year: parseInt(document.getElementById('book-year').value.trim(), 10) || new Date().getFullYear(),
          quote: document.getElementById('book-quote').value.trim(),
          description: document.getElementById('book-description').value.trim(),
          coverImage: document.getElementById('book-cover-url').value.trim(),
        };

        const books = getCustomBooks();
        books.push(newBook);
        saveCustomBooks(books);

        closeModal(addBookModal);
        renderCustomBooks();
        showToast(`הספר "${newBook.title}" נוסף בהצלחה!`);
      };
    }

    // Open Add Poem Modal
    const btnAddPoem = document.getElementById('btn-open-add-poem');
    if (btnAddPoem) {
      btnAddPoem.onclick = () => {
        document.getElementById('form-add-poem').reset();
        document.getElementById('poem-id').value = 'poem-' + Date.now();
        openModal(addPoemModal);
      };
    }

    // Save Poem Form
    const poemForm = document.getElementById('form-add-poem');
    if (poemForm) {
      poemForm.onsubmit = (e) => {
        e.preventDefault();
        const hebrewRaw = document.getElementById('poem-hebrew-text').value.trim();
        const sourceRaw = document.getElementById('poem-source-text').value.trim();

        const newPoem = {
          id: document.getElementById('poem-id').value || 'poem-' + Date.now(),
          title: document.getElementById('poem-title').value.trim(),
          poet: document.getElementById('poem-poet').value.trim(),
          sourceLanguage: document.getElementById('poem-language').value.trim(),
          year: document.getElementById('poem-year').value.trim(),
          publishedIn: document.getElementById('poem-published').value.trim(),
          hebrewText: hebrewRaw.split('\n').map((l) => l.trim()),
          sourceText: sourceRaw ? sourceRaw.split('\n').map((l) => l.trim()) : [],
          contextNote: document.getElementById('poem-context').value.trim(),
        };

        const poems = getCustomPoems();
        poems.push(newPoem);
        saveCustomPoems(poems);

        closeModal(addPoemModal);
        renderCustomPoems();
        showToast(`השיר "${newPoem.title}" נוסף בהצלחה!`);
      };
    }

    // Replace Image Modal Confirm & File
    const replaceFile = document.getElementById('replace-image-file');
    const replaceUrl = document.getElementById('replace-image-url');
    const replacePreview = document.getElementById('replace-image-preview');
    const replacePlaceholder = document.getElementById('replace-image-placeholder');
    const btnConfirmImg = document.getElementById('btn-confirm-replace-image');

    if (replaceFile) {
      replaceFile.onchange = () => {
        const file = replaceFile.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (evt) => {
            replacePreview.src = evt.target.result;
            replacePreview.classList.remove('hidden');
            if (replacePlaceholder) replacePlaceholder.classList.add('hidden');
            if (replaceUrl) replaceUrl.value = '';
          };
          reader.readAsDataURL(file);
        }
      };
    }

    if (replaceUrl) {
      replaceUrl.oninput = () => {
        const val = replaceUrl.value.trim();
        if (val) {
          replacePreview.src = val;
          replacePreview.classList.remove('hidden');
          if (replacePlaceholder) replacePlaceholder.classList.add('hidden');
        }
      };
    }

    if (btnConfirmImg) {
      btnConfirmImg.onclick = () => {
        const targetId = document.getElementById('replace-image-target-id').value;
        const newSrc = replacePreview.src;
        if (!targetId || !newSrc || newSrc.length < 5) {
          alert('אנא בחר קובץ תמונה או הזן קישור תקף.');
          return;
        }

        const images = getSavedImages();
        images[targetId] = newSrc;
        localStorage.setItem(STORAGE_KEYS.IMAGES, JSON.stringify(images));

        applySavedImages();
        closeModal(replaceImgModal);
        showToast('התמונה עודכנה בהצלחה!');
      };
    }

    // Export Data Modal
    const btnExport = document.getElementById('btn-open-export');
    const exportTextarea = document.getElementById('export-json-textarea');
    const btnCopyExport = document.getElementById('btn-copy-export');
    const btnDownloadExport = document.getElementById('btn-download-export');

    if (btnExport) {
      btnExport.onclick = () => {
        const payload = {
          exportDate: new Date().toISOString(),
          panelOrder: getSavedPanelOrder(),
          textEdits: getSavedTexts(),
          images: getSavedImages(),
          customBooks: getCustomBooks(),
          customPoems: getCustomPoems(),
        };

        if (exportTextarea) {
          exportTextarea.value = JSON.stringify(payload, null, 2);
        }
        openModal(exportModal);
      };
    }

    if (btnCopyExport && exportTextarea) {
      btnCopyExport.onclick = () => {
        navigator.clipboard.writeText(exportTextarea.value).then(() => {
          showToast('הנתונים הועתקו ללוח!');
        });
      };
    }

    if (btnDownloadExport && exportTextarea) {
      btnDownloadExport.onclick = () => {
        const blob = new Blob([exportTextarea.value], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `yakov-lach-site-data-${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast('הקובץ הורד בהצלחה!');
      };
    }

    // Reset All Data
    const btnReset = document.getElementById('btn-reset-data');
    if (btnReset) {
      btnReset.onclick = () => {
        if (confirm('אזהרה: פעולה זו תאפס את כל השינויים (טקסטים, ספרים שנוספו, שירים ותמונות) חזרה לערכי ברירת המחדל של האתר. להמשיך?')) {
          localStorage.removeItem(STORAGE_KEYS.TEXTS);
          localStorage.removeItem(STORAGE_KEYS.BOOKS);
          localStorage.removeItem(STORAGE_KEYS.POEMS);
          localStorage.removeItem(STORAGE_KEYS.IMAGES);
          localStorage.removeItem(STORAGE_KEYS.PANEL_ORDER);
          localStorage.removeItem(STORAGE_KEYS.PASSWORD);
          location.reload();
        }
      };
    }
  }

  // --- On Page Load Execution ---
  document.addEventListener('DOMContentLoaded', () => {
    applyPanelOrder();
    applySavedTexts();
    applySavedImages();
    renderCustomBooks();
    renderCustomPoems();

    setupEventListeners();

    if (checkAuth()) {
      setAuth(true);
    }
  });
})();
</script>
